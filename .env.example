# === Application Configuration ===
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === PostgreSQL Database ===
# Connection string for Railway PostgreSQL instance
DATABASE_URL=postgresql://postgres:password@localhost:5432/aftermath_db

# === Paystack Integration (Test Mode) ===
# Found in Paystack Dashboard -> Settings -> API Keys & Webhooks
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
PAYSTACK_WEBHOOK_SECRET=sk_test_your_secret_key_here

# === LLM Provider (Autonomous Agent Reasoning) ===
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# === neatlogs Agent Observability & Tracing ===
# Found in neatlogs Dashboard -> API Keys
NEATLOGS_API_KEY=nl_live_your_neatlogs_api_key_here
NEATLOGS_ENDPOINT=https://eu.ingest.neatlogs.com
NEATLOGS_WORKFLOW_NAME=aftermath-recovery

# === Operator Console Security ===
# Secret token for authorizing simulation sandbox actions
OPERATOR_SECRET_KEY=your_secure_operator_secret_here
