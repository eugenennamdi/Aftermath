# ==============================================================================
# Aftermath — Environment Configuration Reference (.env.example)
# Single-Service Railway Deployment + Neon Free PostgreSQL 18 (neatHack 2026)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Runtime & Origin Configuration (Single-Service Container: Web + Worker)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# Canonical public application URL (Required in production for strict CSRF fail-closed validation)
APP_URL=https://aftermath-production.up.railway.app
NEXT_PUBLIC_APP_URL=https://aftermath-production.up.railway.app

# Optional comma-separated additional trusted origins for CSRF allowlisting
TRUSTED_ORIGINS=https://aftermath-production.up.railway.app

# ------------------------------------------------------------------------------
# 2. Neon PostgreSQL 18 Database Integration
# ------------------------------------------------------------------------------
# POOLED connection string for runtime application traffic (PgBouncer transaction pooler)
# Note the '-pooler.' in the host and '?sslmode=require'.
DATABASE_URL=postgresql://neondb_owner:your_neon_password@ep-cool-fog-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# OPTIONAL: DIRECT unpooled connection string for DDL migrations (without '-pooler.')
# If omitted, Aftermath automatically derives this from DATABASE_URL by stripping '-pooler.'.
MIGRATION_DATABASE_URL=postgresql://neondb_owner:your_neon_password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Connection pool ceiling per container (Defaults to 4 in production for Neon Free Tier & 512 MB RAM limit)
DB_MAX_CONNECTIONS=4

# ------------------------------------------------------------------------------
# 3. Security Credentials & Secrets (Production Fails Closed)
# ------------------------------------------------------------------------------
# Operator Console authentication passphrase and session signing (MUST be >= 16 characters)
OPERATOR_SECRET=your_super_secure_operator_secret_min_16_chars

# Server-to-server worker tick and automated test checkout secret (MUST be >= 16 characters)
CRON_SECRET=your_super_secure_cron_secret_min_16_chars

# Production Scenario Lab execution toggle (Optional; defaults to 'false' in production)
ENABLE_SCENARIO_LAB=false

# ------------------------------------------------------------------------------
# 4. Paystack Payment Gateway — Test Mode
# ------------------------------------------------------------------------------
# Secret key for server-side independent transaction verification and test checkout initialization
PAYSTACK_SECRET_KEY=sk_test_your_paystack_test_secret_key

# Public key for client-side Paystack operations
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_test_public_key

# ------------------------------------------------------------------------------
# 5. Sponsored AI Model Configuration: Claude Sonnet 4.6 (Worker Engine)
# ------------------------------------------------------------------------------
# Sponsored neatHack LiteLLM API Gateway (Zero personally funded spend invariant)
# NOTE: No GEMINI_API_KEY or personally funded provider keys are authorized in production.
LITELLM_API_KEY=your_sponsored_litellm_api_key_here
LITELLM_BASE_URL=https://litellm.vision.aivar.app/v1
LITELLM_MODEL=claude-sonnet-4.6

# Bounded agent token budget ceiling per investigation (Defaults to 12000)
INVESTIGATION_TOKEN_BUDGET=12000

# ------------------------------------------------------------------------------
# 6. neatlogs Observability & Distributed Tracing (Web & Worker)
# ------------------------------------------------------------------------------
# Real-time workflow, LLM span, and tool execution observability
NEATLOGS_API_KEY=nl_live_your_neatlogs_api_key_here
NEATLOGS_ENDPOINT=https://eu.ingest.neatlogs.com
NEATLOGS_WORKFLOW_NAME=aftermath-recovery

# ------------------------------------------------------------------------------
# 7. Single-Service Supervisor Options
# ------------------------------------------------------------------------------
# Optional toggle to disable background recovery worker in single-service container (default: false)
DISABLE_WORKER=false
