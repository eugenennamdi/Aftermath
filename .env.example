# ==============================================================================
# Aftermath — Environment Configuration Reference (.env.example)
# Production Deployment: Web Service & Autonomous Recovery Worker (neatHack 2026)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Runtime & Origin Configuration (Service: Web & Worker)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# Canonical public application URL (Required in production for strict CSRF fail-closed validation)
APP_URL=https://your-aftermath-app.up.railway.app
NEXT_PUBLIC_APP_URL=https://your-aftermath-app.up.railway.app

# Optional comma-separated additional trusted origins for CSRF allowlisting
TRUSTED_ORIGINS=https://your-aftermath-app.up.railway.app

# ------------------------------------------------------------------------------
# 2. PostgreSQL Relational Database (Service: Web & Worker)
# ------------------------------------------------------------------------------
# Authoritative relational store for orders, customers, entitlements, incidents, leases, and audit logs.
DATABASE_URL=postgresql://postgres:your_password@your-railway-pg-host:5432/railway

# ------------------------------------------------------------------------------
# 3. Security Credentials & Secrets (Service: Web & Worker)
# ------------------------------------------------------------------------------
# Operator Console authentication passphrase (MUST be >= 16 characters in production)
OPERATOR_SECRET=your_super_secure_operator_passphrase_min_16_chars

# Server-to-server worker tick and cron authentication secret (MUST be >= 16 characters)
CRON_SECRET=your_super_secure_cron_secret_min_16_chars

# Enable Scenario Lab execution in production (Optional; defaults to 'false' in production)
ENABLE_SCENARIO_LAB=false

# ------------------------------------------------------------------------------
# 4. Paystack Payment Gateway — Test Mode (Service: Web & Worker)
# ------------------------------------------------------------------------------
# Secret key for server-side independent transaction verification and test checkout
PAYSTACK_SECRET_KEY=sk_test_your_paystack_test_secret_key

# ------------------------------------------------------------------------------
# 5. Sponsored AI Model Configuration: Claude Sonnet 4.6 (Service: Worker)
# ------------------------------------------------------------------------------
# Sponsored neatHack LiteLLM API Gateway (Zero personally funded spend invariant)
LITELLM_API_KEY=your_sponsored_litellm_api_key_here
LITELLM_BASE_URL=https://litellm.vision.aivar.app/v1
LITELLM_MODEL=claude-sonnet-4.6

# Bounded agent token budget ceiling per investigation (Defaults to 12000)
INVESTIGATION_TOKEN_BUDGET=12000

# ------------------------------------------------------------------------------
# 6. neatlogs Observability & Distributed Tracing (Service: Web & Worker)
# ------------------------------------------------------------------------------
# Real-time workflow, LLM span, and tool execution observability
NEATLOGS_API_KEY=nl_live_your_neatlogs_api_key_here
NEATLOGS_ENDPOINT=https://eu.ingest.neatlogs.com
NEATLOGS_WORKFLOW_NAME=aftermath-recovery
